bbe","ccdec","ccbcdd","cdde","cdba","cbb","cbecad","baeaaa","baeba","bcbdae","bcbcd","aeaead","aebee","abaada","eebdaa","eeecbcb","ebeecdd","becd","bea","ebde","eccdbdd","ecabade","ebea","cebdb","ccea","caba","abac","acdd","acc","accd","acce","cacc","acddecbd","acdccbcd","acebbe","acebc","cabbc","ebb","ebc","ebcc","ecdcc","bbc","bbcbd","bbcbdbbd","bbcad","bbe","bbea","bbec","bbcabad","eaace","eaaadcea","ebdac","ebcddaa","ebaecb","eecb","bdb","bdea","bdcdb","beed","beedb","eedb","eedcdd","baebdaa","badcdae","bacc","dabddd","abb","abbcaea","acbeceeb","cbdb","cbbdd","cbeac","bcae","bcbbd","bbcc","bbceee","bcab","ebcec","aebcbd","aebb","bddeeac","beecdda","bcebeebd","cddd","cbdaceac","dbb","dbeeb","dbeeeaac","ebdae","ebdeea","edbeeb","aebad","eeaadbe","bacbca","bacbe","bbd","bbdd","bbdda","bbdb","bbdbca","bcbea","bba","cbcabb","caaab","acbbecbb","aaeebd","aaeee","aaeb","dbaeb","ddbb","ddd","bdaadbee","bdbeeeaa","bbadcd","bbedc","bdcdbe","baabdcb","bdaedc","dabccb","dabacc","deac","dbbdc","eaccb","eeacdc","edaedce","cdbbcbce","dadeecd","ddda","ddabc","dbcec","ddbbc","dcaaeb","caabc","caabcd","cadde","cdcee","cdccc","daade","adbdbec","aaedb","adeecccc","adced","abcabbd","dcceccd","cccee","cecaad","ccbdce","ecaadbcc","ecdce","eedd","eccc","edceccda","edcad","ecbdadc","cbdadab","ceddac","dadbbdee","bdcdadbb","caed","caaad","daedcc","cdcceec","cdeed","cccecda","abecae","abecaea","bedda","bacaec","eadcae","ecaeda","ecaedaca","eabaeade","ceadccab","ccae","ccaa","ccaab","aedced","aedd","eedccb","deccecea","caeedd","ccbeeccb","cbed","dcbed","bccbd","bcdaaedc","bcdceadc"]}],"solution":{"explanation":"<p>Build a trie of the words; DFS from every cell, moving through the trie in step with the grid and stopping as soon as the current path isn't a prefix of any word. Remove found words (and empty trie branches) so later searches skip them. Shared prefixes are explored once: that's the trie's whole value.</p>","python":"def word_search_ii(board, words):\n    root = {}\n    for w in words:\n        n = root\n        for c in w: n = n.setdefault(c, {})\n        n[\"$\"] = w\n    R_, C = len(board), len(board[0]); found = []\n    def dfs(r, c, node):\n        ch = board[r][c]\n        nxt = node.get(ch)\n        if not nxt: return\n        if \"$\" in nxt: found.append(nxt.pop(\"$\"))\n        board[r][c] = \"#\"\n        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n            rr, cc = r + dr, c + dc\n            if 0 <= rr < R_ and 0 <= cc < C and board[rr][cc] != \"#\": dfs(rr, cc, nxt)\n        board[r][c] = ch\n        if not nxt: node.pop(ch)\n    for r in range(R_):\n        for c in range(C): dfs(r, c, root)\n    return found\n"}}