],[51,64,305],[43,79,427],[14,8,433],[61,53,151],[59,43,390],[34,92,495],[12,54,119],[89,57,134],[1,27,24],[9,22,234],[81,86,119],[97,90,302],[74,45,473],[75,39,21],[12,56,485],[84,27,341],[51,23,371],[64,3,433],[62,35,111],[55,8,293],[57,12,31],[36,77,478],[11,8,308],[23,92,175],[69,95,425],[42,99,406],[48,88,236],[15,54,193],[89,71,138],[1,90,438],[80,7,291],[9,28,341],[26,63,444],[13,21,163],[43,67,78],[37,11,492],[12,28,233],[87,4,16],[45,66,284],[99,74,289],[0,8,16],[97,52,272],[86,17,186],[31,56,397],[89,39,440],[14,35,447],[46,55,56],[66,68,445],[84,59,145],[7,74,402],[19,27,59],[34,81,488],[31,61,496],[64,78,252],[81,19,194],[51,55,428],[78,15,276],[65,81,458],[58,24,390],[25,30,181],[77,72,105],[75,83,169],[44,0,206],[14,46,413],[38,28,377],[5,65,1],[68,63,247],[0,98,325],[90,45,199],[18,29,365],[10,32,412],[46,80,56],[1,71,3],[45,26,494],[4,53,83],[37,69,329],[65,88,27],[66,87,352],[97,42,498],[69,48,14],[84,73,178],[27,4,63],[53,58,409],[22,19,383],[58,89,361],[94,10,414],[38,4,246],[16,8,316],[35,82,468],[10,70,486],[92,32,311],[56,95,56],[45,97,115],[85,63,248],[63,76,111],[15,90,28],[61,25,273],[58,72,108],[76,32,491],[28,49,57],[34,11,480],[64,7,107],[1,47,453],[83,53,75],[37,52,291],[85,21,280],[44,42,385],[99,61,314],[34,68,350],[20,56,192],[35,57,54],[58,59,463],[83,84,85],[41,50,189],[20,1,201],[78,24,116],[62,49,48],[5,14,479],[99,8,335],[36,33,433],[95,94,85],[98,15,284],[87,35,450],[86,12,280],[78,28,128],[34,25,429],[74,4,301],[12,33,55],[8,67,222],[61,48,407],[89,16,68],[55,91,476],[54,81,426],[99,23,455],[49,85,465],[67,79,79],[95,93,241],[78,65,438],[29,19,458],[7,2,127]],0,99,2],"expected":-1}],"solution":{"explanation":"<p>A constraint on the number of edges changes the state. Bellman\u2013Ford's round structure fits exactly: after round i, d holds the best cost using \u2264 i edges, <em>provided you relax from a copy of the previous round</em> (relaxing in place lets one round chain several edges). Alternatively Dijkstra on states (node, flights used).</p>","python":"def find_cheapest_price(n, flights, src, dst, k):\n    INF = float('inf')\n    d = [INF] * n\n    d[src] = 0\n    for _ in range(k + 1):\n        nd = d[:]\n        for u, v, w in flights:\n            if d[u] + w < nd[v]:\n                nd[v] = d[u] + w\n        d = nd\n    return -1 if d[dst] == INF else d[dst]\n","cpp":"int findCheapestPrice(int n, vector<vector<int>>& f, int s, int t, int k) {\n    const long long INF = LLONG_MAX / 4; vector<long long> d(n, INF); d[s] = 0;\n    for (int r = 0; r <= k; r++) { auto nd = d; for (auto& e : f) if (d[e[0]] + e[2] < nd[e[1]]) nd[e[1]] = d[e[0]] + e[2]; d = nd; }\n    return d[t] >= INF ? -1 : (int)d[t];\n}\n"}}