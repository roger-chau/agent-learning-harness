540],[1,681,722],[1,943,952],[1,430,856],[4,125,199],[4,267,764],[4,938,996],[5,947,958],[2,368,557],[2,340,503],[1,592,654],[5,370,709],[4,969,999],[2,691,871],[5,328,551],[5,302,655],[1,297,941],[1,99,948],[3,805,995],[4,192,574],[2,135,246],[1,266,659],[1,322,505],[3,590,906],[3,160,388],[1,924,946],[2,581,641],[5,721,859],[5,152,593],[4,840,891],[1,276,537],[1,930,981],[1,679,784],[5,492,677],[1,348,775],[1,581,960],[1,329,807],[3,71,79],[5,345,877],[1,193,505],[1,17,702],[2,407,542],[4,150,319],[1,120,209],[3,625,682],[1,332,516],[2,271,902],[4,779,931],[5,153,578],[1,200,521],[3,523,724],[3,171,381],[2,206,666],[4,409,741],[1,640,889],[3,120,504],[4,566,960],[4,544,705],[5,775,980],[2,167,530],[3,597,763],[1,923,966],[3,301,838],[4,648,659],[5,757,981],[4,193,413],[2,362,944],[2,614,668],[1,930,969],[2,687,800],[1,933,941],[1,308,602],[4,349,785],[4,125,789],[4,604,766],[2,171,518],[1,720,734],[1,718,840],[4,600,869]],600],"expected":false}],"solution":{"explanation":"<p>A difference array: add n at index from and subtract n at index to; the prefix sum is the load at each point. Check it never exceeds capacity. O(trips + 1000). With a huge coordinate range, sort the 2\u00b7trips events instead (a sweep line).</p>","python":"def car_pooling(trips, capacity):\n    diff = [0] * 1002\n    for n, a, b in trips:\n        diff[a] += n; diff[b] -= n\n    load = 0\n    for d in diff:\n        load += d\n        if load > capacity: return False\n    return True\n","cpp":"bool carPooling(vector<vector<int>>& trips, int capacity) {\n    vector<int> d(1002, 0);\n    for (auto& t : trips) { d[t[1]] += t[0]; d[t[2]] -= t[0]; }\n    int load = 0;\n    for (int x : d) { load += x; if (load > capacity) return false; }\n    return true;\n}\n"}}