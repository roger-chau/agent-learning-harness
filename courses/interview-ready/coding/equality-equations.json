{"id":"equality-equations","title":"Satisfiability of equality equations","difficulty":"medium","pattern":"union-find, then check","statement":"<p>Each equation is \"a==b\" or \"a!=b\" over lowercase single-letter variables. Return whether integers can be assigned to satisfy all of them.</p>","entry":{"python":"equations_possible","cpp":{"name":"equationsPossible","ret":"bool","params":[["vector<string>","eqs"]]}},"kind":"function","compare":"exact","time_limit_ms":2000,"hints":["Equalities are transitive: they build connected components.","Two passes: union all the '==', then check every '!=' crosses components."],"complexity":"O(n \u03b1(26))","starter":{"python":"def equations_possible(eqs):\n    pass\n","cpp":"bool equationsPossible(vector<string>& eqs) {\n    \n}\n"},"tests":[{"args":[["a==b","b!=a"]],"expected":false,"sample":true},{"args":[["b==a","a==b"]],"expected":true,"sample":true},{"args":[["a==b","b==c","a==c"]],"expected":true},{"args":[["a==b","b!=c","c==a"]],"expected":false},{"args":[["c==c","b==d","x!=z"]],"expected":true},{"args":[["a!=a"]],"expected":false},{"args":[["j!=i","i!=d","d!=e","g!=d","g!=h","a!=h","h!=a","g!=a","j!=f","h==i","a!=h","i!=j","a!=e","a!=e","f==f","f!=j","e!=a","h!=c","c==a","g==e","c==a","e==g","d!=c","j==a","b!=a","e!=f","d!=c","j!=d","a==j","i!=c","a!=b","c!=h","i!=c","b!=h","c!=i","i!=g","c==j","g!=i","g!=d","g!=c","b!=a","d!=c","a==a","h!=b","a==j","e!=j","d!=f","f==h","g==g","i!=g","c!=g","f==f","g!=d","g!=j","a!=h","i!=g","b==g","b==g","a!=b","e!=i","a==a","b!=a","c!=h","d!=a","c==a","f!=c","d!=g","a==a","i!=a","g!=d","e==e","j!=i","h!=c","e!=a","h!=d","c==a","c!=h","j==c","i!=b","e!=i","i==h","e!=h","f!=c","b!=f","j!=d","d==d","h!=c","a==c","f!=e","c!=d","f==f","j!=i","e!=d","i!=c","f==h","d!=c","d==d","e!=d","j!=i","c!=h","g==g","e!=f","a!=g","g==e","b==e","f!=g","e!=c","h!=b","f!=c","j!=f","f!=e","f!=b","e!=f","d!=b","i!=b","h==i","g!=c","d!=i","d==d","i!=g","a!=b","j!=e","c!=i","e!=j","g!=a","j!=i","f==i","i!=b","f==f","b!=d","d!=h","c!=h","g!=i","a!=i","g!=a","c!=d","g==e","c==c","h!=d","i!=e","c!=h","d!=c","f==f","i==h","b==e","g!=j","e!=f","e==g","g==g","i!=e","a!=g","b!=j","c!=h","a==a","b!=i","f!=c","j!=f","f==i","e==b","g!=i","i!=b","c==a","i!=b","i!=c","c==c","h==i","c==c","c!=b","c!=f","d!=c","d!=e","g==b","i==f","j!=e","c!=f","b!=i","i!=j","f!=g","a!=h","g!=h","f!=j","c!=i","g!=d","i!=j","e!=f","c!=e","a==a","f!=c","e!=f","b==b","e!=i","g==e","f!=j","a!=b","d!=g","b!=h","j!=f","e!=j","h==h","a==a"]],"expected":true},{"args":[["g!=b","d!=j","a!=h","c==d","b==a","d==d","i!=g","d==e","g==g","h!=d","g!=b","e!=g","b!=e","h!=b","b==a","e==e","b!=e","e!=f","i!=h","d!=f","j==i","j!=h","a==b","c!=h","d!=j","c!=j","b!=j","g!=a","i==j","e!=i","e!=f","c!=b","f!=d","d==d","h!=i","j!=c","f==g","b!=h","f==g","d==e","g!=c","c!=b","j==i","c!=j","h==g","d!=f","a!=f","f!=b","b!=f","b!=j","j==i","e==d","f==f","e==e","d!=i","c==d","g!=b","e==d","b!=g","h==f","e!=g","j!=a","i!=b","c==e","f==f","f!=j","e==d","e==e","e!=h","d==d","e!=a","b!=f","f==f","i!=g","e!=j","j!=c","e!=i","h==g","f!=b","b!=j","d!=j","h!=c","i!=d","h!=c","g!=e","h!=d","b==a","c!=a","i!=e","f!=j","h!=a","e==e","j!=d","b!=g","c==c","g!=e","b!=f","d!=g","b!=j","i!=b","b!=d","e!=i","f!=a","c!=h","b!=d","h!=b","j!=f","j==i","h==h","g==g","j!=e","f!=b","e!=i","e!=a","g!=j","f!=i","g!=j","g!=a","i!=h","a!=e","a!=c","c==c","h!=d","a!=e","f!=e","d!=j","j!=b","f==g","e!=h","h!=b","c!=h","g==h","f==h","i!=b","j!=b","g!=b","c!=i","e!=f","f!=a","g!=b","f==g","i!=h","g!=b","c!=g","a!=d","e!=j","f!=i","f!=i","e!=i","e==e","b!=d","g!=e","e!=i","g!=i","c==d","b!=h","j!=b","h!=c","a!=h","f==f","h!=i","e==c","d!=a","c!=g","a!=h","f!=b","c!=j","e!=j","b!=f","h!=e","c!=f","g!=c","j!=b","c!=a","h==g","h!=e","c!=f","g!=a","i!=d","g==f","g!=b","c==e","d!=i","h!=j","e!=b","b!=i","c!=h","b!=h","f!=j","c!=i","i!=d","d!=i","f==f","j==i","b!=f","b!=j","a!=h","h!=d","c!=j","i!=d","g==b"]],"expected":false}],"solution":{"explanation":"<p>Order of processing is the trick: inequalities only make sense once all the equalities are merged. Union every \"==\", then fail if any \"!=\" has both sides in the same set. \"a!=a\" is the edge case.</p>","python":"def equations_possible(eqs):\n    parent = list(range(26))\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    for e in eqs:\n        if e[1] == '=':\n            parent[find(ord(e[0]) - 97)] = find(ord(e[3]) - 97)\n    return all(find(ord(e[0]) - 97) != find(ord(e[3]) - 97) for e in eqs if e[1] == '!')\n","cpp":"bool equationsPossible(vector<string>& eqs) {\n    int p[26]; iota(p, p + 26, 0); auto f = [&](int x) { while (p[x] != x) { p[x] = p[p[x]]; x = p[x]; } return x; };\n    for (auto& e : eqs) if (e[1] == '=') p[f(e[0] - 'a')] = f(e[3] - 'a');\n    for (auto& e : eqs) if (e[1] == '!' && f(e[0] - 'a') == f(e[3] - 'a')) return false;\n    return true;\n}\n"}}