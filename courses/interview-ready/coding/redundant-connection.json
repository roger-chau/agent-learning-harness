67],[144,622],[92,562],[487,907],[32,533],[631,679],[224,264],[257,941],[437,659],[500,991],[456,929],[312,932],[209,564],[538,960],[118,712],[191,817],[2,114],[233,418],[645,858],[34,327],[56,649],[420,558],[635,676],[56,170],[322,535],[132,258],[598,807],[552,603],[277,405],[788,931],[14,300],[317,466],[324,850],[192,320],[308,991],[218,906],[591,982],[410,646],[370,920],[379,635],[279,443],[15,851],[556,792],[61,165],[569,769],[688,885],[637,660],[154,726],[217,786],[207,499],[820,834],[315,331],[72,967],[157,571],[152,494],[463,799],[41,696],[36,348],[240,761],[85,661],[140,402],[176,675],[108,881],[186,283],[69,224],[21,601],[814,991],[88,470],[305,422],[190,587],[185,820],[179,578],[230,394],[626,684],[405,832],[803,960],[496,822],[711,846],[228,364],[135,747],[166,220],[503,585],[335,759],[195,857],[132,398],[109,323],[270,620],[176,593],[41,401],[12,727],[93,674],[815,956],[553,572],[12,991],[122,606],[334,948],[202,460],[711,966],[51,283],[337,791],[135,271],[56,496],[822,907],[55,56],[96,779]]],"expected":[132,398]}],"solution":{"explanation":"<p>Processing edges in order, the first edge joining two already-connected nodes closes the unique cycle, and it's the last cycle edge in the input, which is what's asked. This \"is it already connected?\" query is exactly what union-find answers in near-O(1).</p>","python":"def find_redundant_connection(edges):\n    n = len(edges)\n    parent = list(range(n + 1))\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n    for u, v in edges:\n        a, b = find(u), find(v)\n        if a == b:\n            return [u, v]\n        parent[a] = b\n","cpp":"vector<int> findRedundantConnection(vector<vector<int>>& e) {\n    int n = e.size(); vector<int> p(n + 1); iota(p.begin(), p.end(), 0);\n    auto f = [&](int x) { while (p[x] != x) { p[x] = p[p[x]]; x = p[x]; } return x; };\n    for (auto& ed : e) { int a = f(ed[0]), b = f(ed[1]); if (a == b) return ed; p[a] = b; }\n    return {};\n}\n"}}