ding at this node, left + right heights). Computing heights separately per node would be O(n\u00b2).</p>","python":"def diameter(root):\n    best = 0\n    def h(n):\n        nonlocal best\n        if not n: return 0\n        l, r = h(n.left), h(n.right)\n        best = max(best, l + r)\n        return 1 + max(l, r)\n    h(root)\n    return best\n","cpp":"int best_;\nint h_(TreeNode* n) { if (!n) return 0; int l = h_(n->left), r = h_(n->right); best_ = max(best_, l + r); return 1 + max(l, r); }\nint diameterOfBinaryTree(TreeNode* root) { best_ = 0; h_(root); return best_; }\n"},"arg_kinds":["tree"],"ret_kind":null}