0810],[-696655,563902],[541150,353053],[636904,-599166],[658205,-652822],[916639,-390765],[-52700,122995],[-234005,-238871],[-620945,-331062],[906184,525881],[211514,218740],[-195125,936607],[-813387,771959],[-505875,678208],[-393115,-460821],[-441817,-597914],[-534688,-337345],[-25223,895748],[62823,-177352],[-968764,81651],[296563,-158720],[744862,-132128],[907237,-190621],[689485,197419],[83198,-16885],[-169255,-330616],[-75717,-877859],[212701,-578851],[933289,903367],[461750,-557676],[148196,726672],[-334067,-806364],[172559,-32563],[-108622,-441119],[255926,842520],[-925850,21706],[-171457,936826],[640654,-194863],[539175,718440],[13441,895785],[-9303,-73415],[715261,812518],[499558,882802],[17904,-59496],[-743943,-398893],[588551,639678],[-826264,-280258],[213048,54372],[-362105,-895554],[569937,271116],[-872611,-60289],[-781403,73254],[-124086,881316],[18203,-745845],[746222,209892],[-359893,868835],[-618136,948642],[-942810,-449340],[144353,407193],[-867772,493143],[68384,-681619],[-524587,250006],[939798,-899593],[402637,-639454],[-838970,-939748],[409782,-976011],[-727228,73205],[-456344,565603],[-655395,999129],[-55397,-884674],[301137,-901743],[138027,951423],[-151461,118369],[217580,329206],[187269,-921685],[71688,-650349],[509815,575641],[91321,-669833],[-982552,418017],[303078,207127],[774052,703278],[697804,286795],[-796707,664530],[-624777,-160105],[508460,-199401],[673383,446763],[-129806,-19410],[-157093,257916],[-90632,391260],[-133144,-761456],[-720131,-526698],[-114543,98585],[359456,112807],[654847,-206985],[-574061,639725],[215710,-15870],[963682,803948],[704496,-412098],[-624885,-50684],[-634481,704147],[-166496,287058],[586785,164183],[158600,-284279],[-206973,960522],[-694790,-580021],[-195536,-310796],[991055,-41253],[-196810,-380207],[-756087,126348],[-599634,-249225],[764742,330159],[505278,696602],[-345990,27264],[-954912,926182],[538056,-825409],[902960,-705119],[-269655,986044],[-299950,766884],[-195589,613628],[853023,835069],[-290798,536174],[233252,787484],[898239,760594],[-69426,-788650],[-853893,-168932],[164275,936063],[-170538,-753688],[-51782,541799],[673008,-594647],[448391,-111322],[-592896,-474525]]],"expected":40318204}],"solution":{"explanation":"<p>An MST. Kruskal on all n\u00b2 edges costs O(n\u00b2 log n) time and O(n\u00b2) memory; <strong>array Prim</strong> keeps, for each point not yet in the tree, its cheapest connection, and repeatedly adds the closest: O(n\u00b2) time and O(n) memory. Picking the algorithm by graph density is the lesson. The cut property (the cheapest edge leaving any cut belongs to some MST) is why both greedy algorithms are correct.</p>","python":"def min_cost_connect_points(points):\n    n = len(points); INF = float(\"inf\"); best = [INF] * n; best[0] = 0; used = [False] * n; total = 0\n    for _ in range(n):\n        u = min((i for i in range(n) if not used[i]), key=best.__getitem__)\n        used[u] = True; total += best[u]; ux, uy = points[u]\n        for v in range(n):\n            if not used[v]:\n                d = abs(points[v][0] - ux) + abs(points[v][1] - uy)\n                if d < best[v]: best[v] = d\n    return total\n","cpp":"int minCostConnectPoints(vector<vector<int>>& P) {\n    int n = P.size(); vector<int> best(n, INT_MAX); vector<bool> used(n, false); best[0] = 0; long long total = 0;\n    for (int it = 0; it < n; it++) { int u = -1; for (int i = 0; i < n; i++) if (!used[i] && (u < 0 || best[i] < best[u])) u = i;\n        used[u] = true; total += best[u];\n        for (int v = 0; v < n; v++) if (!used[v]) best[v] = min(best[v], abs(P[v][0] - P[u][0]) + abs(P[v][1] - P[u][1])); }\n    return (int)total;\n}\n"}}