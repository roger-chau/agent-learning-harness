"aaaca","aacaa"],["dcccc"],["bbeae","eabbe","aebeb"],["bebece"],["ddbbb"],["daaa","aada","daaa","aada"],["ecbee","ebeec","bceee"],["eeee","eeee"],["ddaaba"],["ecbe","beec","eceb"],["dacdcd","daddcc"],["bdcdde","ebdddc","bdecdd"],["daacda"],["ebeada","eaebad","eaaebd"],["abbb"],["beddbd"],["beeabb","ebeabb"],["aababa"],["ceeccc"],["cddd","ddcd"],["ebeccc","ccebce","ebccce","cecbce"],["bddee"],["bcabcb"],["bbbee"],["bbabde"],["ecbccc"],["cbbbeb","bebbbc","ebbcbb"],["bdeddd"],["cddddc"],["dbcbcc","ccbdcb"],["dceddd"],["dccdac"],["eaabbe"],["edeadd"],["cadecc"],["babbba"],["bdccbd"],["eceeac"],["abbabd"],["cbcabc"],["cdccee","cedcec","eccecd"],["bcebb"],["cacca"],["aaeace","eaceaa"],["cccdcb"],["ecdced"],["aecce"],["aacdaa"],["baccc","accbc"],["bddddd"],["eeeede"],["aeeada"],["ddbbdc"],["eccdcc"],["debbb"]]}],"solution":{"explanation":"<p>Map each string to a canonical key that's equal exactly for anagrams: its sorted letters (O(k log k)) or its letter counts (O(k)). Group by key in a hash map. Total O(n \u00b7 k log k) or O(n \u00b7 k).</p>","python":"import collections\n\ndef group_anagrams(strs):\n    groups = collections.defaultdict(list)\n    for s in strs:\n        groups[\"\".join(sorted(s))].append(s)\n    return list(groups.values())\n","cpp":"vector<vector<string>> groupAnagrams(vector<string>& strs) {\n    unordered_map<string, vector<string>> g;\n    for (auto& s : strs) { string k = s; sort(k.begin(), k.end()); g[k].push_back(s); }\n    vector<vector<string>> out;\n    for (auto& [k, v] : g) out.push_back(v);\n    return out;\n}\n"}}