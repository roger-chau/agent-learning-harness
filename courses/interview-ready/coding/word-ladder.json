ae","ceccd","edcae","adeee","eaedc","daede","aadbe","bbcbb","cbccd","cdccc","eeccb","baddb","ddcba","cbaca","aabcb","acceb","bbcda","ddbda","bbada","bcabb","bcbba","dedac","aedea","eecaa","edeac","bdcac","eeedb","edbea","eaaad","dadad","ebedb","ddded","ababe","bbcea","bdedb","ccceb","aedda","adabb","baddc","eacdc","ccabc","dabde","aeacb","ebdae","daadc","cbbab","cbbad","dacbe","bcdea","bbedd","dccec","baebe","bcabe","adbca","adbad","eccda","eadec","dbccc","bbbdd","dcdab","bedad","aecea","ececc","becba","eaccd","bcbdc","dbbcc","dadda","eaabb","dcaae","acdaa","aeeac","edaca","ecade","dbece","dbaed","acead","cdeac","dbacd","ebeae","abbbb","ddada","addae","ebcda","ddeca","debea","beadd","aebea","eecbd","aedbc","bbccb","bbcaa","dadbe","bdadb","dbbec","dcbed","cdeab","cbbac","bdcce","daadb","bbabe","dcdcb","adbda","aceaa","ccdba","ebbed","abdaa","bdeed","ceece","ccbbc","ebacd","bdaec","beacb","ebadc","abdee","abecc","beddd","dcccc","beeca","cbdba","aadca","dadac","aaaac","ddeaa","caeeb","cdaba","dccce","abaee","dcbcc","abbca","cebab","cdccb","eedbe","edabc","cbcca","aceea","edeee","eebab","ecadb","ddaba","ebdbd","dddcd","ebada","bbadb","eccbb","deeda","dcaaa","cbbec","deabe","eaeea","deddc","cdabe","aecbc","dcdee","addbe","beabc","cbeeb","ecbbc","ecdbe","bcace","becdb","adebd","cbdce","acadb","aacdd","aebad","eddde","ecadd","cebee","adeab","eabbe","dbbeb","cdedd","eeecc","cbaea","aeaaa","cceec","acdbe","cbdcd","babae","acaba","eeaad","edcbc","ebddb","abcba","badcc","cccdd","eaacb","cecbc","dcdec","bdbee","bcebd","bbbdc","abbba","cebdd","adada","aeece","addec","eeaaa","edded","ccbac","aeaea","aaabe","debcb","edbda","abdbe","dbbca","acbac","abcde","bbeed","babbe","ebebe","eebec","bbade","adedd","abadd","edced","dabcb","aeeab","baeac","eceea","bdacb","eecec","bebcb","dccdc","cccde","edadc","eadbe","eeade","bdacc","eddec","ecaca","aedce","babac","eeabe","ccddd","dcdca","decbb","ecbea","aecdb","dcdad","dabbb","ceebb","aaecb","bccbd","bdbae","eaabc","ceccb","aaaca","cbcce","ecaea","dacba","daaca","ececb","dcabd","cbedc","aeedc","dbeca","bebed","ebcaa","bdccc","bbdae","ddacd","eeceb","ebdcc","ecdcd","ecced","ecdba","aeddc","dbbae","adcee","eceac","cdbae","dbcdc","dcbee","dddee","cdcab","aceed","ccbbb","dcddb","bbeeb","ecbae","bdbdc","adeda","cbeda","deace","daada","ecace","dacca","dcabe","aebdc","bcaab","ddcae","aaaba","abbaa","ebaee","dbdaa","eabca","beaaa","dbabe","dabec","aadee","aabec","bdbbb","deecb","dbcca","cdced","aaebe","ceeeb","dbbde","bebca","bdecd","dbaee","cceeb","caebe","ddcbb","edcde","cacee","edddc","decda","eeedc","deeac","ebeca","abdbc","eeced","aacac","abadb","acede","deebc","ddbcb","baeca","ddbde","dcaeb","cdbdb","cceed","bbeda","abcbb","adcce","babcb","cbdec","cbbea","edcee","bebbb","dbeea","eebbb","cbeab","bbcdb","aecaa","cceab","ebdde","eabdd","bdaae","dbcbe","ecebc","ceabb","bbeaa","baedc","cbada","cbaad","cebda","cbbbc","bedbe","cbaec","ccaed","ebccb","cbede","ecada","bdcdb","bcbda","aeceb","deaec","bccce"]],"expected":6},{"args":["bbdae","aabbc",["dbcde","abbad","caaae","cecea","cbaac","dedad","aedda","eeacb","dbddc","abaaa","acacb","aaacd","aecea","caeda","eceab","cedad","bcbea","ccccc","daecc","daabe","eabde","adbcb","becea","ddeea","ddabc","dccbb","bcecb","ecacd","aabbc"]],"expected":0}],"solution":{"explanation":"<p>An <strong>implicit graph</strong>: generate neighbours on demand. Comparing every pair of words to build edges is O(N\u00b2 L); trying 26 replacements per position with set lookups is O(N \u00b7 L \u00b7 26). Bidirectional BFS roughly square-roots the frontier for a further constant-factor win.</p>","python":"import collections\n\ndef ladder_length(begin, end, words):\n    words = set(words)\n    if end not in words: return 0\n    q = collections.deque([(begin, 1)]); seen = {begin}\n    while q:\n        w, d = q.popleft()\n        if w == end: return d\n        for i in range(len(w)):\n            for ch in \"abcdefghijklmnopqrstuvwxyz\":\n                nw = w[:i] + ch + w[i + 1:]\n                if nw in words and nw not in seen: seen.add(nw); q.append((nw, d + 1))\n    return 0\n","cpp":"int ladderLength(string b, string e, vector<string>& words) {\n    unordered_set<string> ws(words.begin(), words.end()); if (!ws.count(e)) return 0;\n    deque<pair<string,int>> q{{b, 1}}; unordered_set<string> seen{b};\n    while (!q.empty()) { auto [w, d] = q.front(); q.pop_front(); if (w == e) return d;\n        for (size_t i = 0; i < w.size(); i++) { string nw = w; for (char c = 'a'; c <= 'z'; c++) { nw[i] = c; if (ws.count(nw) && !seen.count(nw)) { seen.insert(nw); q.push_back({nw, d + 1}); } } } }\n    return 0;\n}\n"}}