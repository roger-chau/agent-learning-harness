s","nr","nrvmr","nrdacr","nxqc","nxl","nebfv","necwjy","nawz","nyyxt","nyvhk","nynusaz","nky","nkl","nkb","nvv","nvzmxw","nd","ndog","nq","nqealy","nqdcmrx","ns","nsfce","nlx","nh","nhvcp","nhfs","nmthif","nmq","nmhmijd","nmibvma","nbrbrw","nbgrjmr","nbnoxqt","nbppnj","nbc","nocge","nzti","nzu","nzrcsb","nzfyo","nnxnqto","nnvhctv","nf","nfb","ncmz","p","puyfc","pezviyw","paywesn","pad","pg","pghhd","py","pyoi","pypdkdw","pj","pkh","pvk","pwvsukd","pdbx","pqaluol","pqsmlg","pse","pszhaaa","plwd","plhb","plm","ph","philtlg","pmdhzsj","pbwxf","pbccsy","pn","pnr","pneqk","pni","ppals","pi","pivybd","pft","pfqajcx","pfojtku","pcicbc","i","itnwpfa","iu","irhdop","ixv","ixh","ie","iezzs","ia","iaxa","iaybpls","igkhflo","iydd","iydzwnn","ij","ijvm","ik","ikrvy","iv","iwr","iwwwhr","iwzag","iduwe","idg","iqhkss","iqbcpho","isthd","il","ilh","im","immw","io","iotivh","iowmf","izrffi","ipu","ipxfjo","ipkrf","ipvnbpf","ipzo","ipi","ipcahi","ifd","icv","ichyc","iczz","icn","f","fr","frgwc","fx","fxuceug","fxjkws","fxm","fevg","faegq","fg","fgak","fglox","fysoay","fybcrl","fju","fjuqn","fjy","fkess","fka","fvgajvq","fvy","fwass","fdo","fq","flmmab","fh","fhkwin","fhoqb","fb","fbr","fbww","fbdaab","fbq","fowcg","fobr","fzjays","fngcnjd","fpxarl","fitr","filgghf","fihxj","fim","ff","ffwvzri","fcu","fcuukq","fcgror","fcpsv","c","cunmk","ceeqz","cefgr","caeds","cavig","cj","ckxx","cks","cvtv","cvhbhji","cwuif","cwzg","cd","cqigfzs","cszdh","cl","chdfqq","chpa","cmt","cmuogca","cmridul","cmg","cb","cbwmd","cbnnb","co","cog","covac","cofd","cz","czgwc","cn","cp","cptgfmc","cpsn","civrmqv","cfg","cfyb","ccyamo","ccns","ccpo"]],"expected":"turxeagyjkvwdqslhmboznpifc"}],"solution":{"explanation":"<p>The modelling step is the interview: only <em>adjacent</em> pairs matter, and each yields one edge (first mismatch) or a validity check (prefix rule). Then it's Course order: Kahn with a min-heap over the letters, and \"\" if a cycle leaves letters unprocessed.</p>","python":"import heapq\n\nimport heapq\n\ndef alien_order(words):\n    letters = sorted(set(''.join(words)))\n    g = {c: set() for c in letters}\n    indeg = {c: 0 for c in letters}\n    for a, b in zip(words, words[1:]):\n        for x, y in zip(a, b):\n            if x != y:\n                if y not in g[x]:\n                    g[x].add(y)\n                    indeg[y] += 1\n                break\n        else:\n            if len(a) > len(b):\n                return ''\n    h = [c for c in letters if indeg[c] == 0]\n    heapq.heapify(h)\n    out = []\n    while h:\n        c = heapq.heappop(h)\n        out.append(c)\n        for d in g[c]:\n            indeg[d] -= 1\n            if indeg[d] == 0:\n                heapq.heappush(h, d)\n    return ''.join(out) if len(out) == len(letters) else ''\n","cpp":"string alienOrder(vector<string>& w) {\n    bool has[26] = {}; bool e[26][26] = {}; int indeg[26] = {};\n    for (auto& s : w) for (char c : s) has[c - 'a'] = true;\n    for (size_t i = 0; i + 1 < w.size(); i++) { auto& a = w[i]; auto& b = w[i + 1]; size_t k = 0;\n        while (k < a.size() && k < b.size() && a[k] == b[k]) k++;\n        if (k == a.size() || k == b.size()) { if (a.size() > b.size()) return \"\"; continue; }\n        int x = a[k] - 'a', y = b[k] - 'a'; if (!e[x][y]) { e[x][y] = true; indeg[y]++; } }\n    priority_queue<int, vector<int>, greater<int>> h; int total = 0;\n    for (int c = 0; c < 26; c++) if (has[c]) { total++; if (!indeg[c]) h.push(c); }\n    string out; while (!h.empty()) { int c = h.top(); h.pop(); out += char('a' + c); for (int d = 0; d < 26; d++) if (e[c][d] && --indeg[d] == 0) h.push(d); }\n    return (int)out.size() == total ? out : \"\";\n}\n"}}