t = max(best, n.val + l + r)\n        return n.val + max(l, r)\n    gain(root)\n    return best\n","cpp":"int bestP_;\nint gain_(TreeNode* n) { if (!n) return 0; int l = max(gain_(n->left), 0), r = max(gain_(n->right), 0); bestP_ = max(bestP_, n->val + l + r); return n->val + max(l, r); }\nint maxPathSum(TreeNode* root) { bestP_ = INT_MIN; gain_(root); return bestP_; }\n"},"arg_kinds":["tree"],"ret_kind":null}