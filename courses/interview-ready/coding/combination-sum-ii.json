0,11,14],[5,11,24],[5,13,22],[5,15,20],[5,17,18],[7,8,8,17],[7,8,10,15],[7,8,11,14],[7,11,22],[7,13,20],[7,15,18],[7,16,17],[8,8,10,14],[8,8,11,13],[8,8,24],[8,10,22],[8,14,18],[8,15,17],[8,16,16],[10,13,17],[10,14,16],[11,13,16],[11,14,15],[11,29],[14,26],[16,24],[18,22]]}],"solution":{"explanation":"<p>Combinations (not permutations) come from a <strong>start index</strong>: only choose elements at or after the last one. Duplicate combinations come from choosing equal values as <em>siblings</em>: skip cands[i] if i &gt; start and it equals cands[i \u2212 1]. Sorting also enables the <code>break</code> pruning: everything after is too large.</p>","python":"def combination_sum2(cands, target):\n    cands = sorted(cands); out = []; cur = []\n    def bt(start, rem):\n        if rem == 0: out.append(cur[:]); return\n        for i in range(start, len(cands)):\n            if i > start and cands[i] == cands[i - 1]: continue\n            if cands[i] > rem: break\n            cur.append(cands[i]); bt(i + 1, rem - cands[i]); cur.pop()\n    bt(0, target); return out\n","cpp":"vector<vector<int>> res_; vector<int> path_;\nvoid go_(vector<int>& c, int s, int rem) {\n    if (rem == 0) { res_.push_back(path_); return; }\n    for (int i = s; i < (int)c.size(); i++) { if (i > s && c[i] == c[i-1]) continue; if (c[i] > rem) break; path_.push_back(c[i]); go_(c, i + 1, rem - c[i]); path_.pop_back(); }\n}\nvector<vector<int>> combinationSum2(vector<int>& c, int target) { sort(c.begin(), c.end()); res_.clear(); path_.clear(); go_(c, 0, target); return res_; }\n"}}